{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nauagency-vibe-trading",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "vibetrading.nauagency.asia",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "VibeTradingContainer",
      "image": "../Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VIBE_CONTAINER",
        "class_name": "VibeTradingContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VibeTradingContainer"]
    }
  ],
  "secrets": {
    "required": ["API_AUTH_KEY", "OPENAI_API_KEY", "SITE_USERNAME", "SITE_PASSWORD", "SITE_SESSION_SECRET", "VIBE_BRIDGE_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
